# Copy to model_compare.env (gitignored) and fill in remote settings if desired.
#
# Local quality model (Phase 2 — pulled via Ollama if missing)
LOCAL_QUALITY_MODEL=qwen2.5:14b-instruct

# Apertus 8B (Phase 1b — skipped if not pulled)
# APERTUS_MODEL=hf.co/bartowski/swiss-ai_Apertus-8B-Instruct-2509-GGUF:Q4_K_M

# --- Optional remote (Phase 3) ---
# Any OpenAI-compatible endpoint: SURF vLLM, OpenRouter, remote Ollama, etc.
#
# SURF / self-hosted vLLM example:
# TRIFECTA_REMOTE_BASE_URL=https://your-surf-host/v1
# TRIFECTA_REMOTE_MODEL=qwen2.5-coder-32b-instruct
# TRIFECTA_REMOTE_API_KEY=your-token
# TRIFECTA_REMOTE_LABEL=qwen-32b-surf
#
# OpenRouter example (pay-per-token, no local GPU load):
# TRIFECTA_REMOTE_BASE_URL=https://openrouter.ai/api/v1
# TRIFECTA_REMOTE_MODEL=qwen/qwen2.5-coder-32b-instruct
# TRIFECTA_REMOTE_API_KEY=sk-or-...
# TRIFECTA_REMOTE_LABEL=qwen-32b-openrouter

TRIFECTA_REMOTE_BASE_URL=
TRIFECTA_REMOTE_MODEL=
TRIFECTA_REMOTE_API_KEY=
TRIFECTA_REMOTE_LABEL=remote
