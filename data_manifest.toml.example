# Copy to data_manifest.toml and edit tier roots + absolute source paths.
# cp data_manifest.toml.example data_manifest.toml
# Optional: cp data_manifest.local.toml.example data_manifest.local.toml

[phases]
explore = "jsonl, pkl, xlsx, ad-hoc notebooks"
semi = "jsonl, markdown+yaml frontmatter"
frozen = "parquet (duckdb-queryable)"

[tiers.hot]
root = "/Users/you/develop"
mount_check = ""

[tiers.warm]
root = "/Volumes/your-warm-drive"
mount_check = "/Volumes/your-warm-drive"

[tiers.scratch]
root = "/Volumes/your-scratch-drive/scratch"
mount_check = "/Volumes/your-scratch-drive"

[tiers.local]
root = "/path/to/trifecta-annotation/data_local"
mount_check = ""

# --- ontology (sibling repo, optional) ---

[datasets.food_terms]
tier = "warm"
path = "reference/Food_terms.csv"
phase = "frozen"
description = "TRIFECTA food ontology"
parent = ""

# --- cort_voc_db snippet sources (absolute paths; not in git) ---

[datasets.food_snippets_source]
tier = "hot"
path = "/path/to/OneDrive/data/trifecta/cort_voc_db/processed_outputs/food_snippets_for_annotation.csv"
phase = "frozen"
description = "Canonical food snippets CSV on OneDrive"
parent = ""

[datasets.food_snippets_long_source]
tier = "hot"
path = "/path/to/OneDrive/data/trifecta/cort_voc_db/processed_outputs/food_snippets_long.csv"
phase = "frozen"
description = "Exploded food snippets — one row per matched keyword"
parent = ""

[datasets.food_snippets_manual_source]
tier = "hot"
path = "/path/to/snippets_for_annotation.txt"
phase = "semi"
description = "Manual annotation snippet list"
parent = ""

# --- scratch copies (created by scripts/ingest_food_snippets.py) ---

[datasets.food_snippets]
tier = "scratch"
path = "trifecta/food_snippets_for_annotation.csv"
phase = "frozen"
description = "Working copy of food snippets CSV"
parent = "food_snippets_source"

[datasets.food_snippets_long]
tier = "scratch"
path = "trifecta/food_snippets_long.csv"
phase = "frozen"
description = "Working copy of exploded food snippets (one keyword per row)"
parent = "food_snippets_long_source"

[datasets.food_snippets_manual]
tier = "scratch"
path = "trifecta/snippets_for_annotation.txt"
phase = "semi"
description = "Working copy of manual annotation snippets txt"
parent = "food_snippets_manual_source"

[datasets.food_snippets_kwic_xlsx_source]
tier = "hot"
path = "/path/to/Downloads/food_snippets_for_annotation.xlsx"
phase = "frozen"
description = "KWIC batch xlsx with manual_labels"
parent = ""

[datasets.food_snippets_kwic]
tier = "scratch"
path = "trifecta/food_snippets_kwic.csv"
phase = "frozen"
description = "KWIC wide CSV with manual_labels"
parent = "food_snippets_kwic_xlsx_source"

[datasets.food_snippets_long_kwic]
tier = "scratch"
path = "trifecta/food_snippets_long_kwic.csv"
phase = "frozen"
description = "Deduped exploded KWIC snippets (kwic_batch column)"
parent = "food_snippets_kwic"

# --- other corpora (optional sibling repos) ---

[datasets.recipe_web]
tier = "hot"
path = "Dutch-historical-recipe-trends/Corpus/clean_recipe_web.csv"
phase = "frozen"
description = "20th-c. newspaper recipes"
parent = ""

# --- pipeline outputs (scratch tier; gitignored under trifecta/) ---

[datasets.trifecta_thesaurus]
tier = "scratch"
path = "trifecta/trifecta_thesaurus.csv"
phase = "semi"
description = "Merged food thesaurus (pref_label + aliases + keep flags)"
